# Server Port
PORT=5000

# MongoDB Connection String:
# Option A: Local MongoDB (Default)
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager

# Option B: MongoDB Atlas Cloud (Uncomment and replace with your credentials)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager?retryWrites=true&w=majority

# Client frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Environment mode
NODE_ENV=development
